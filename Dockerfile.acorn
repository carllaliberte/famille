FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV ACORN_RUNTIME_ROOT=/app
ENV ACORN_WORK_STATE_PATH=/data/continuous-work-state.json
ENV ACORN_RUN_INTERVAL_MS=30000
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi
COPY scripts ./scripts
COPY sdk ./sdk
COPY schema ./schema
COPY map ./map
COPY .github/swarm ./github/swarm
RUN node --check scripts/acorn-cloud-runner.mjs && node --check scripts/acorn-work-engine.mjs && node --check scripts/acorn-continuous-runtime.mjs
VOLUME ["/data"]
CMD ["node","scripts/acorn-cloud-runner.mjs"]
