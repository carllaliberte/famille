{
  "$id": "https://github.com/carllaliberte/famille/schema/juge.v0.json",
  "title": "famille.juge.v0",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "quelle": { "enum": ["os", "qrng", "qkd"] },
    "temoin": { "enum": ["aucun", "stat", "fabricant", "di"] },
    "epsilon": {
      "description": "Nombre > 0. Interdit: 0, none, iid."
    },
    "horizon": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date calendrier future. UFHY1 n'est pas une date."
    },
    "appareil": { "type": "string" },
    "transcript": { "type": "string" },
    "simule": { "type": "boolean" }
  },
  "required": ["quelle", "temoin", "epsilon", "horizon"]
}
