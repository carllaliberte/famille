{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ACORN Cognitive Knowledge Contribution v1",
  "type":"object",
  "additionalProperties":false,
  "required":["version","id","source_identity","kind","subject","content","state","provenance","observed_at"],
  "properties":{
    "version":{"const":"cognitive-knowledge.v1"},
    "id":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source_identity":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,63}$"},
    "kind":{"enum":["knowledge","observation","method","capability","limit","failure","measurement","evidence"]},
    "subject":{"type":"string","minLength":1},
    "content":{"type":"string","minLength":1},
    "conditions":{"type":"array","items":{"type":"string"}},
    "state":{"enum":["declared","observed","measured","verified","retracted"]},
    "provenance":{"type":"object","additionalProperties":false,"required":["source","observed_at"],"properties":{"source":{"type":"string","minLength":1},"observed_at":{"type":"string","format":"date-time"},"evidence_refs":{"type":"array","items":{"type":"string"}}}},
    "evidence_refs":{"type":"array","items":{"type":"string"}},
    "observed_at":{"type":"string","format":"date-time"},
    "valid_from":{"type":"string","format":"date-time"},
    "valid_until":{"type":"string","format":"date-time"},
    "supersedes":{"type":"array","items":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
    "retracts":{"type":"array","items":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
  }
}
