#!/usr/bin/env bash
set -euo pipefail

SELF_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REAL_CODEX=""
IFS=':' read -r -a PATH_PARTS <<< "${PATH:-}"
for dir in "${PATH_PARTS[@]}"; do
  [ -n "$dir" ] || dir="."
  [ "$dir" = "$SELF_DIR" ] && continue
  if [ -x "$dir/codex" ]; then
    REAL_CODEX="$dir/codex"
    break
  fi
done

if [ -z "$REAL_CODEX" ]; then
  echo "codex-budget-wrapper: real codex executable not found" >&2
  exit 127
fi

case "${1:-}" in
  --version|-V|version|login|logout)
    exec "$REAL_CODEX" "$@"
    ;;
esac

CONFIG_HOME="${CODEX_HOME:-${HOME:-}/.codex}"
CONFIG_FILE="$CONFIG_HOME/config.toml"
if [ ! -f "$CONFIG_FILE" ] || ! grep -q 'model_provider = "openrouter"' "$CONFIG_FILE" || [ -z "${OPENROUTER_API_KEY:-}" ]; then
  exec "$REAL_CODEX" "$@"
fi

PORT="${CODEX_OPENROUTER_PROXY_PORT:-17891}"
BUDGET="${CODEX_MAX_OUTPUT_TOKENS:-1024}"
PROXY_LOG="$(mktemp)"
TMP_HOME="$(mktemp -d)"
PROXY_PID=""
DIAGNOSTIC="${CODEX_PROXY_DIAGNOSTIC:-0}"
cleanup() {
  if [ -n "$PROXY_PID" ]; then kill "$PROXY_PID" 2>/dev/null || true; fi
  rm -f "$PROXY_LOG"
  rm -rf "$TMP_HOME"
}
trap cleanup EXIT INT TERM

cp "$CONFIG_FILE" "$TMP_HOME/config.toml"
sed -i 's#base_url = "https://openrouter.ai/api/v1"#base_url = "http://127.0.0.1:'"$PORT"'/v1"#' "$TMP_HOME/config.toml"

CODEX_PROXY_DIAGNOSTIC="$DIAGNOSTIC" node "$SELF_DIR/codex-openrouter-budget-proxy.mjs" --port "$PORT" --max-output-tokens "$BUDGET" >"$PROXY_LOG" 2>&1 &
PROXY_PID=$!

for _ in $(seq 1 50); do
  if (echo >/dev/tcp/127.0.0.1/"$PORT") >/dev/null 2>&1; then break; fi
  sleep 0.1
done
if ! kill -0 "$PROXY_PID" 2>/dev/null; then
  cat "$PROXY_LOG" >&2 || true
  exit 1
fi

if [ "$DIAGNOSTIC" = "1" ]; then
  set +e
  CODEX_HOME="$TMP_HOME" "$REAL_CODEX" "$@"
  STATUS=$?
  set -e
  echo "CODEX_PROXY_DIAGNOSTIC_EXIT status=$STATUS" >&2
  cat "$PROXY_LOG" >&2 || true
  exit "$STATUS"
fi

CODEX_HOME="$TMP_HOME" exec "$REAL_CODEX" "$@"
