#!/bin/sh
ref=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0
case "$ref" in
  main) exit 0 ;;
  ville/juge-*|ville/conso-*|ville/preview-*|ville/sdk-*|ville/rente-*|ville/garde-*) exit 0 ;;
  ville/noms|ville/preview-build|ville/preview-langue|ville/preview-attest|ville/preview-badge*) exit 0 ;;
  cursor/*) exit 0 ;;
  docs/*) exit 0 ;;
  schema/*) exit 0 ;;
  grok/auto-*) exit 0 ;;
esac
echo "Branche refusée: $ref"
echo "Attendu: ville/<quartier>-<piece> | cursor/<piece> | docs/<piece> | schema/<piece> | grok/auto-*"
exit 1
